{
  "version": 1,
  "author": "ESP32 Healthcare IoT - Phase 1",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 140,
      "left": 220,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 0,
      "left": 0,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 0,
      "left": 430,
      "attrs": { "temperature": "24", "humidity": "55" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_hr",
      "top": 380,
      "left": 30,
      "attrs": { "label": "Heart Rate (60-180 bpm)", "value": "512" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_spo2",
      "top": 380,
      "left": 200,
      "attrs": { "label": "SpO2 (85-100%)", "value": "3600" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_abnormal",
      "top": 370,
      "left": 380,
      "attrs": { "color": "red", "label": "Force Abnormal" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_simfail",
      "top": 370,
      "left": 480,
      "attrs": { "color": "orange", "label": "Simulate Failure" }
    },
    {
      "type": "wokwi-led",
      "id": "led_alert",
      "top": 290,
      "left": 450,
      "attrs": { "color": "red", "label": "Alert LED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_led",
      "top": 290,
      "left": 390,
      "attrs": { "value": "330" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": 290,
      "left": 530,
      "attrs": { "volume": "0.5" }
    },
    {
      "type": "wokwi-servo",
      "id": "servo_bed",
      "top": 240,
      "left": 620,
      "attrs": { "label": "Bed Elevation (0-90 deg)" }
    }
  ],
  "connections": [
    ["oled:GND", "esp:GND.1", "black", ["v20", "h180"]],
    ["oled:VCC", "esp:3V3", "red", ["v10", "h240"]],
    ["oled:SDA", "esp:D21", "green", ["v15", "h270"]],
    ["oled:SCL", "esp:D22", "blue", ["v5", "h290"]],

    ["dht1:GND", "esp:GND.2", "black", []],
    ["dht1:VCC", "esp:3V3", "red", []],
    ["dht1:SDA", "esp:D4", "yellow", []],

    ["pot_hr:GND", "esp:GND.1", "black", []],
    ["pot_hr:VCC", "esp:3V3", "red", []],
    ["pot_hr:SIG", "esp:D34", "purple", []],

    ["pot_spo2:GND", "esp:GND.1", "black", []],
    ["pot_spo2:VCC", "esp:3V3", "red", []],
    ["pot_spo2:SIG", "esp:D35", "purple", []],

    ["btn_abnormal:1.l", "esp:GND.1", "black", []],
    ["btn_abnormal:2.l", "esp:D13", "green", []],

    ["btn_simfail:1.l", "esp:GND.1", "black", []],
    ["btn_simfail:2.l", "esp:D12", "orange", []],

    ["r_led:1", "esp:D2", "red", []],
    ["r_led:2", "led_alert:A", "red", []],
    ["led_alert:K", "esp:GND.2", "black", []],

    ["buzzer1:1", "esp:D25", "blue", []],
    ["buzzer1:2", "esp:GND.1", "black", []],

    ["servo_bed:GND", "esp:GND.2", "black", []],
    ["servo_bed:V+", "esp:3V3", "red", []],
    ["servo_bed:PWM", "esp:D18", "orange", []]
  ],
  "dependencies": {}
}
